diff --git a/ggml/src/ggml-cuda/kda-gate.cu b/ggml/src/ggml-cuda/kda-gate.cu
new file mode 100644
index 0000000..ba1ad47
--- /dev/null
+++ b/ggml/src/ggml-cuda/kda-gate.cu
@@ -0,0 +1,117 @@
+#include "kda-gate.cuh"
+
+// KDA forget-gate epilogue: dst = lower_bound * sigmoid(-((x + dt_b) * a))
+//                               = lower_bound / (1 + expf((x + dt_b) * a))
+// x [d_inner, n_tokens], dt_b [d_inner], a [n_head] broadcast per head_dim block.
+// Replaces the ADD -> MUL -> SCALE -> SIGMOID -> SCALE chain the unfused graph
+// builds per KDA layer.
+static __global__ void kda_gate_f32(
+        const float * __restrict__ x,
+        const float * __restrict__ dt_b,
+        const float * __restrict__ a,
+              float * __restrict__ dst,
+        const int64_t n,
+        const int     d_inner,
+        const int     head_dim,
+        const float   lower_bound) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+
+    const int i0 = (int) (i % d_inner);
+
+    const float v = (x[i] + dt_b[i0]) * a[i0/head_dim];
+
+    dst[i] = lower_bound / (1.0f + expf(v));
+}
+
+void ggml_cuda_op_kda_gate(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * dt_b = dst->src[1];
+    const ggml_tensor * a    = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x));
+
+    const int64_t n       = ggml_nelements(dst);
+    const int     d_inner = (int) x->ne[0];
+    const int     n_head  = (int) a->ne[0];
+
+    float lower_bound;
+    memcpy(&lower_bound, dst->op_params, sizeof(float));
+
+    const int block = 256;
+    const int64_t grid = (n + block - 1)/block;
+
+    kda_gate_f32<<<grid, block, 0, ctx.stream()>>>(
+            (const float *) x->data, (const float *) dt_b->data, (const float *) a->data,
+            (float *) dst->data, n, d_inner, d_inner/n_head, lower_bound);
+}
+
+// KDA output epilogue: dst = rms_norm(x, eps) * w * sigmoid(gate)
+// x/gate [head_dim, n_head, n_tokens], w [head_dim]; the RMS reduction runs over
+// ne0 (head_dim) only, one weight vector shared by every head. Replaces the
+// RMS_NORM -> MUL(w) -> SIGMOID -> MUL chain per KDA layer.
+static __global__ void kda_out_gate_f32(
+        const float * __restrict__ x,
+        const float * __restrict__ w,
+        const float * __restrict__ gate,
+              float * __restrict__ dst,
+        const int   head_dim,
+        const float eps) {
+    const int64_t row = blockIdx.x;           // one block per (head, token) row
+    const float * xr = x    + row*head_dim;
+    const float * gr = gate + row*head_dim;
+          float * dr = dst  + row*head_dim;
+
+    float sumsq = 0.0f;
+    for (int c = threadIdx.x; c < head_dim; c += blockDim.x) {
+        const float v = xr[c];
+        sumsq += v*v;
+    }
+    sumsq = warp_reduce_sum(sumsq);
+
+    __shared__ float s_warp[32];
+    const int warp = threadIdx.x/WARP_SIZE;
+    const int lane = threadIdx.x%WARP_SIZE;
+    if (lane == 0) {
+        s_warp[warp] = sumsq;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        sumsq = lane < blockDim.x/WARP_SIZE ? s_warp[lane] : 0.0f;
+        sumsq = warp_reduce_sum(sumsq);
+        if (lane == 0) {
+            s_warp[0] = rsqrtf(sumsq/head_dim + eps);
+        }
+    }
+    __syncthreads();
+    const float rrms = s_warp[0];
+
+    for (int c = threadIdx.x; c < head_dim; c += blockDim.x) {
+        const float sig = 1.0f/(1.0f + expf(-gr[c]));
+        dr[c] = xr[c]*rrms * w[c] * sig;
+    }
+}
+
+void ggml_cuda_op_kda_out_gate(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * w    = dst->src[1];
+    const ggml_tensor * gate = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(gate));
+
+    const int     head_dim = (int) x->ne[0];
+    const int64_t n_rows   = ggml_nelements(x)/head_dim;
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+
+    const int block = head_dim <= 128 ? 128 : 256;
+
+    kda_out_gate_f32<<<n_rows, block, 0, ctx.stream()>>>(
+            (const float *) x->data, (const float *) w->data, (const float *) gate->data,
+            (float *) dst->data, head_dim, eps);
+}
