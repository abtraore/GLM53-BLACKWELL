+// ggml_compute_forward_kda_gate
+// dst = lower_bound * sigmoid(-((x + dt_b) * a)), a broadcast per head_dim block
+
+void ggml_compute_forward_kda_gate(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * dt_b = dst->src[1];
+    const ggml_tensor * a    = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(dst));
+
+    const int64_t d_inner  = x->ne[0];
+    const int64_t n_head   = ggml_nelements(a);
+    const int64_t head_dim = d_inner/n_head;
+    const int64_t n_rows   = ggml_nrows(x);
+
+    float lower_bound;
+    memcpy(&lower_bound, dst->op_params, sizeof(float));
+
+    const float * xd = (const float *) x->data;
+    const float * bd = (const float *) dt_b->data;
+    const float * ad = (const float *) a->data;
+          float * dd = (float *) dst->data;
+
+    for (int64_t r = params->ith; r < n_rows; r += params->nth) {
+        const float * xr = xd + r*d_inner;
+              float * dr = dd + r*d_inner;
+        for (int64_t i = 0; i < d_inner; ++i) {
+            const float v = (xr[i] + bd[i]) * ad[i/head_dim];
+            dr[i] = lower_bound / (1.0f + expf(v));
+        }
+    }
+}
+
+// ggml_compute_forward_kda_out_gate
+// dst = rms_norm(x, eps over ne0) * w * sigmoid(gate)
+
+void ggml_compute_forward_kda_out_gate(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * w    = dst->src[1];
+    const ggml_tensor * gate = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(gate) && ggml_is_contiguous(dst));
+
+    const int64_t head_dim = x->ne[0];
+    const int64_t n_rows   = ggml_nelements(x)/head_dim;
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+
+    const float * xd = (const float *) x->data;
+    const float * wd = (const float *) w->data;
+    const float * gd = (const float *) gate->data;
+          float * dd = (float *) dst->data;
+
+    for (int64_t r = params->ith; r < n_rows; r += params->nth) {
+        const float * xr = xd + r*head_dim;
+        const float * gr = gd + r*head_dim;
+              float * dr = dd + r*head_dim;
+
+        float sumsq = 0.0f;
+        for (int64_t c = 0; c < head_dim; ++c) {
+            sumsq += xr[c]*xr[c];
+        }
+        const float rrms = 1.0f/sqrtf(sumsq/head_dim + eps);
+
+        for (int64_t c = 0; c < head_dim; ++c) {
+            const float sig = 1.0f/(1.0f + expf(-gr[c]));
+            dr[c] = xr[c]*rrms * wd[c] * sig;
+        }
+    }
+}
+
