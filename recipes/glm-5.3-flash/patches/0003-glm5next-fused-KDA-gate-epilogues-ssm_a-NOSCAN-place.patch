+// ggml_kda_gate
+
+struct ggml_tensor * ggml_kda_gate(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * dt_b,
+        struct ggml_tensor  * a,
+        float                 lower_bound) {
+    GGML_ASSERT(x->type    == GGML_TYPE_F32);
+    GGML_ASSERT(dt_b->type == GGML_TYPE_F32);
+    GGML_ASSERT(a->type    == GGML_TYPE_F32);
+
+    GGML_ASSERT(ggml_is_contiguous(x));
+    GGML_ASSERT(ggml_is_contiguous(dt_b));
+    GGML_ASSERT(ggml_is_contiguous(a));
+
+    const int64_t d_inner = x->ne[0];
+    const int64_t n_head  = a->ne[0];
+
+    GGML_ASSERT(x->ne[2] == 1 && x->ne[3] == 1);
+    GGML_ASSERT(dt_b->ne[0] == d_inner && ggml_nelements(dt_b) == d_inner);
+    GGML_ASSERT(ggml_nelements(a) == n_head);
+    GGML_ASSERT(n_head > 0 && d_inner % n_head == 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_inner, x->ne[1]);
+
+    ggml_set_op_params_f32(result, 0, lower_bound);
+
+    result->op     = GGML_OP_KDA_GATE;
+    result->src[0] = x;
+    result->src[1] = dt_b;
+    result->src[2] = a;
+
+    return result;
+}
+
+// ggml_kda_out_gate
+
+struct ggml_tensor * ggml_kda_out_gate(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * gate,
+        float                 eps) {
+    GGML_ASSERT(x->type    == GGML_TYPE_F32);
+    GGML_ASSERT(w->type    == GGML_TYPE_F32);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32);
+
+    GGML_ASSERT(ggml_is_contiguous(x));
+    GGML_ASSERT(ggml_is_contiguous(w));
+    GGML_ASSERT(ggml_is_contiguous(gate));
+
+    GGML_ASSERT(x->ne[3] == 1);
+    GGML_ASSERT(ggml_nelements(w) == x->ne[0]);
+    GGML_ASSERT(ggml_are_same_shape(gate, x));
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, x->ne[0], x->ne[1], x->ne[2]);
+
+    ggml_set_op_params_f32(result, 0, eps);
+
+    result->op     = GGML_OP_KDA_OUT_GATE;
+    result->src[0] = x;
+    result->src[1] = w;
+    result->src[2] = gate;
+
+    return result;
+}
